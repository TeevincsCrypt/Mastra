# KeeperHub — server-side only. Never prefix with NEXT_PUBLIC_, never send to the browser.
# Get an API key at app.keeperhub.com -> Settings -> API Keys -> Organisation.
KEEPERHUB_API_KEY=

# The id of a KeeperHub workflow you've created (via their dashboard) that
# performs a small, safe, real action on Sepolia. Mastra's server routes
# execute exactly this workflow — see src/app/api/keeperhub/execute/route.ts.
KEEPERHUB_WORKFLOW_ID=

# The URL of your own deployed wayfinder-service (see that directory) —
# a persistent host running the official Wayfinder Paths SDK's MCP server
# in streamable-http mode, since Vercel functions can't run one themselves.
# NOT yet wired into the main Workflow Review flow — see README for why
# (KeeperHub's dynamic workflow-creation schema doesn't yet safely represent
# an arbitrary Wayfinder swap). Exercised via /wayfinder-test for now.
WAYFINDER_MCP_URL=

# Read only by wayfinder-service itself (Railway/Render/Fly env, not here).
# Not read by the Mastra app directly.
WAYFINDER_API_KEY=
