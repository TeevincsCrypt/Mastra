# KeeperHub — server-side only. Never prefix with NEXT_PUBLIC_, never send to the browser.
# Get an API key at app.keeperhub.com -> Settings -> API Keys -> Organisation.
KEEPERHUB_API_KEY=

# The id of a KeeperHub workflow you've created (via their dashboard) that
# performs a small, safe, real action on Sepolia. Mastra's server routes
# execute exactly this workflow — see src/app/api/keeperhub/execute/route.ts.
KEEPERHUB_WORKFLOW_ID=

# Not yet integrated — see README for why. Reserved for when Wayfinder's
# public API/SDK access becomes available to this project.
WAYFINDER_API_KEY=
