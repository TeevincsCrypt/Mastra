# --- KeeperHub — server-side only. Never prefix with NEXT_PUBLIC_, never send to the browser. ---

# Get an API key at app.keeperhub.com -> Settings -> API Keys -> Organisation.
KEEPERHUB_API_KEY=

# The id of a KeeperHub workflow you've created (via their dashboard) that
# performs a small, safe, real action on Sepolia. Used only by the legacy
# fixed-workflow diagnostic path (src/lib/keeperhub/client.ts) — the real
# mainnet automation flow (src/lib/keeperhub/dynamicSwap.ts) creates its own
# workflow per execution instead and does not need this.
KEEPERHUB_WORKFLOW_ID=

# Alternative to KEEPERHUB_WORKFLOW_ID for the same legacy diagnostic path:
# match an existing KeeperHub workflow by name instead of id.
KEEPERHUB_WORKFLOW_NAME=

# --- Wayfinder ---

# The URL of your own deployed wayfinder-service (see that directory) — a
# persistent host running the official Wayfinder Paths SDK's MCP server in
# streamable-http mode, since Vercel functions can't run one themselves.
# Powers real quotes on /swap, /integrations and the automation execution
# pipeline (onchain_quote_swap, onchain_resolve_token) — quote-only, never
# signs or executes.
WAYFINDER_MCP_URL=

# Read only by wayfinder-service itself (Railway/Render/Fly env, not here).
# Not read by the Mastra app directly.
WAYFINDER_API_KEY=

# --- On-chain reads ---

# Optional. Falls back to a public, no-API-key RPC (ethereum-rpc.publicnode.com)
# if unset. Override with your own Ethereum mainnet RPC endpoint for higher
# reliability/rate limits on real on-chain balance/allowance reads.
MAINNET_RPC_URL=

# --- Mastra authorization (this app's own server-side security boundary) ---

# REQUIRED, no fallback — the app throws on boot if this is unset. Signs and
# verifies session cookies for sign-in-with-wallet (SIWE-style) auth. Use a
# long random value; treat it like any other secret.
MASTRA_SESSION_SECRET=

# Optional. Comma-separated wallet addresses. If set, only these addresses
# may trigger real execution (spend from KeeperHub's shared wallet) or lift
# an emergency pause — anyone can still create/view automations. If unset,
# any signed-in (signature-verified) wallet may execute; this is a disclosed
# gap, not a silent one — see the Security page.
MASTRA_AUTHORIZED_EXECUTORS=

# --- Storage (required for reliable persistence on Vercel) ---

# Without one of these set, Mastra falls back to a JSON file under /tmp on
# Vercel — which works, but does NOT survive across serverless instances or
# cold starts, so an automation created in one request can 404 as "not
# found" in the next ("Automation not found" on Execute right after
# creating it is exactly this). Add a Redis database from the Vercel
# dashboard (Storage tab -> Marketplace -> Upstash for Redis, free tier) and
# it auto-injects KV_REST_API_URL / KV_REST_API_TOKEN on redeploy — no code
# change needed. A raw Upstash database (not through Vercel's integration)
# works too via UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead.
# Local dev always uses the .data/ JSON file regardless of these — a single
# long-running process doesn't have the cross-instance problem.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Mastra AI (optional chat feature) ---

# Read automatically by the Anthropic SDK — no code change needed to wire
# this up. Without it, Mastra AI returns a clear "not configured" error
# rather than failing silently.
ANTHROPIC_API_KEY=
